# Copie este arquivo para .env e ajuste os valores para seu ambiente.
# Mantenha credenciais reais apenas no .env, que e ignorado pelo Git.

# Geracao: endereco interno usado pela aplicacao no Docker Compose.
# Para executar o runner no host com o Ollama do Compose, use
# OLLAMA_BASE_URL=http://localhost:11435
# Para Ollama nativo no host, use http://localhost:11434.
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TEMPERATURE=0.1

# Avaliacao: configuracao independente do modelo usado na geracao.
# Enderecos abaixo: evaluator executado no host, Ollama no Docker Compose.
# Para Ollama nativo, troque 11435 por 11434 nos dois enderecos.
# Dentro da rede do Compose, use http://ollama:11434/v1.
# Os modelos precisam estar disponiveis na instancia do Ollama utilizada.
EVAL_LLM_MODEL=qwen2.5:1.5b
EVAL_LLM_BASE_URL=http://localhost:11435/v1
EVAL_LLM_TEMPERATURE=0
EVAL_LLM_MAX_TOKENS=2048
EVAL_EMBEDDING_MODEL=nomic-embed-text
EVAL_EMBEDDING_BASE_URL=http://localhost:11435/v1
EVAL_TIMEOUT_SECONDS=600

# Autenticacao opcional para servicos compativeis com OpenAI.
# Ollama local nao exige chaves; deixe estas linhas comentadas nesse caso.
# EVAL_LLM_API_KEY=
# EVAL_EMBEDDING_API_KEY=
