# Copie este arquivo para .env e ajuste os valores para seu ambiente.
# Mantenha credenciais reais apenas no .env, que e ignorado pelo Git.

# Geracao: endereco interno usado pela aplicacao no Docker Compose.
# Para executar o runner no host com o Ollama do Compose, use
# OLLAMA_BASE_URL=http://localhost:11435
# Para Ollama nativo no host, use http://localhost:11434.
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TEMPERATURE=0.1

# Recuperacao: configuracao independente do modelo usado na geracao.
# Host -> Ollama publicado pelo Compose: 11435; Ollama nativo: 11434.
# Dentro da rede do Compose: http://ollama:11434 (sem /v1).
OLLAMA_BASE_URL=http://localhost:11435
RETRIEVAL_EMBEDDING_MODEL=embeddinggemma:300m
RETRIEVAL_EMBEDDING_DIMENSION=768
RETRIEVAL_EMBEDDING_PROFILE=embeddinggemma

# Tokens reais do EmbeddingGemma. Comparacoes: 256/512/1024 com overlap constante.
# 50 e uma escolha inicial configuravel, nao uma exigencia do plano.
RETRIEVAL_CHUNK_UNIT=tokens
RETRIEVAL_CHUNK_SIZE=512
RETRIEVAL_CHUNK_OVERLAP=50
RETRIEVAL_TOKENIZER_ID=onnx-community/embeddinggemma-300m-ONNX
RETRIEVAL_TOKENIZER_REVISION=8cd82455fa7fae53af154775fd1494f5577ef4b0

# Inclui prefixos, titulo e tokens especiais; truncate:false tambem e enviado ao Ollama.
RETRIEVAL_EMBEDDING_MAX_TOKENS=2048
RETRIEVAL_TOP_K=5
RETRIEVAL_BATCH_SIZE=32
RETRIEVAL_TIMEOUT_SECONDS=180

# Recorte inicial leve (3 normas IRPF). Use all para indexar os 461 documentos.
RETRIEVAL_CORPUS_SELECTION=data/retrieval/baseline_irpf.json
# Opcionais; padrao relativo a raiz do repositorio:
# RETRIEVAL_DATA_DIR=data/retrieval
# RETRIEVAL_INDEX_DIR=data/retrieval/chroma

# Avaliacao: configuracao independente do modelo usado na geracao.
# Enderecos abaixo: evaluator executado no host, Ollama no Docker Compose.
# Para Ollama nativo, troque 11435 por 11434 nos dois enderecos.
# Dentro da rede do Compose, use http://ollama:11434/v1.
# Os modelos precisam estar disponiveis na instancia do Ollama utilizada.
EVAL_LLM_MODEL=qwen2.5:1.5b
EVAL_LLM_BASE_URL=http://localhost:11435/v1
EVAL_LLM_TEMPERATURE=0
EVAL_LLM_MAX_TOKENS=2048
EVAL_EMBEDDING_MODEL=nomic-embed-text
EVAL_EMBEDDING_BASE_URL=http://localhost:11435/v1
EVAL_TIMEOUT_SECONDS=600

# Autenticacao opcional para servicos compativeis com OpenAI.
# Ollama local nao exige chaves; deixe estas linhas comentadas nesse caso.
# EVAL_LLM_API_KEY=
# EVAL_EMBEDDING_API_KEY=
