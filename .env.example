OLLAMA_MODEL="qwen2.5:1.5b"
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TEMPERATURE=0.1

# Independent evaluator configuration (examples; models must be available).
# These URLs are for running evaluation on the host with Docker Compose Ollama.
EVAL_LLM_MODEL=qwen2.5:7b
EVAL_LLM_BASE_URL=http://localhost:11435/v1
EVAL_LLM_TEMPERATURE=0
EVAL_LLM_MAX_TOKENS=2048
EVAL_EMBEDDING_MODEL=nomic-embed-text
EVAL_EMBEDDING_BASE_URL=http://localhost:11435/v1
EVAL_TIMEOUT_SECONDS=120
# Optional authentication for remote OpenAI-compatible services:
# EVAL_LLM_API_KEY=
# EVAL_EMBEDDING_API_KEY=
